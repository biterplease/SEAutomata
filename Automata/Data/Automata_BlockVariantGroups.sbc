<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <BlockVariantGroups>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="AutomataBlocksGroup" />
            <Icon>Textures\GUI\Icons\Cubes\ProgrammingBlock.dds</Icon>
            <DisplayName>{LOC:DisplayName_Automata_Orchestrator}</DisplayName>
            <Description>{LOC:Description_Automata_Orchestrator}</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataLargeOrchestrator" />
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataLargeConstructionComputer" />
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataLargeLogisticsComputer" />
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataLargeMiningSurveyor" />
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataLargeTargetDesignator" />
                <Block Type="MyObjectBuilder_MyProgrammableBlock" Subtype="AutomataSmallTargetDesignator" />
                <Block Type="MyObjectBuilder_RemoteControl" Subtype="AutomataLargeDroneController" />
                <Block Type="MyObjectBuilder_RemoteControl" Subtype="AutomataSmallDroneController" />
            </Blocks>
        </BlockVariantGroup>
    </BlockVariantGroups>
</Definitions>