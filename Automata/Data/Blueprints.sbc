<?xml version="1.0"?>
<!-- Automata target designators: recipes. Their assembler tabs are in BlueprintClasses.sbc (as vanilla).
     Costs: industrial = the basic hand drill (HandDrill); hostile = the level 2 hand drill (HandDrill3) with its
     upgrade chain's ingots and time added up (8 Fe, 3 Si, 3 Ni, 1.5 Co, 1 Ag; 2 + 3 + 4 s). -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Blueprints>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>Blueprint_AutomataHostileTargetDesignator</SubtypeId>
      </Id>
      <DisplayName>Automata Hostile Target Designator</DisplayName>
      <Icon>Textures\GUI\Icons\Items\AutomataHostileTargetDesignator.dds</Icon>
      <Prerequisites>
        <Item Amount="8" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="3" TypeId="Ingot" SubtypeId="Silicon" />
        <Item Amount="3" TypeId="Ingot" SubtypeId="Nickel" />
        <Item Amount="1.5" TypeId="Ingot" SubtypeId="Cobalt" />
        <Item Amount="1" TypeId="Ingot" SubtypeId="Silver" />
      </Prerequisites>
      <Result Amount="1" TypeId="PhysicalGunObject" SubtypeId="AutomataHostileTargetDesignatorItem" />
      <BaseProductionTimeInSeconds>9</BaseProductionTimeInSeconds>
      <IgnoreEfficiencyMultiplier>true</IgnoreEfficiencyMultiplier>
    </Blueprint>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>Blueprint_AutomataIndustrialTargetDesignator</SubtypeId>
      </Id>
      <DisplayName>Automata Industrial Target Designator</DisplayName>
      <Icon>Textures\GUI\Icons\Items\AutomataIndustrialTargetDesignator.dds</Icon>
      <Prerequisites>
        <Item Amount="8" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="3" TypeId="Ingot" SubtypeId="Silicon" />
        <Item Amount="3" TypeId="Ingot" SubtypeId="Nickel" />
      </Prerequisites>
      <Result Amount="1" TypeId="PhysicalGunObject" SubtypeId="AutomataIndustrialTargetDesignatorItem" />
      <BaseProductionTimeInSeconds>2</BaseProductionTimeInSeconds>
      <IgnoreEfficiencyMultiplier>true</IgnoreEfficiencyMultiplier>
    </Blueprint>
  </Blueprints>
</Definitions>